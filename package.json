{
  "name": "liquidity-radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "vinext dev",
    "dev:vercel": "next dev",
    "build": "next build",
    "build:sites": "vinext build",
    "start": "next start",
    "start:sites": "vinext start",
    "worker": "tsx worker/runner.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write \"{app,db,lib,scripts,tests,worker}/**/*.{ts,tsx,mjs,css,json}\"",
    "format:check": "prettier --check \"{app,db,lib,scripts,tests,worker}/**/*.{ts,tsx,mjs,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --configLoader runner --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run data:audit-valuations && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "data:sync-public": "tsx scripts/sync-public-data.ts",
    "data:sync-motion": "tsx scripts/sync-money-in-motion.ts",
    "data:report-motion": "tsx scripts/report-money-in-motion.ts",
    "data:backfill-gdelt": "tsx scripts/backfill-gdelt.ts",
    "source:normalize-import": "tsx scripts/normalize-source-import.ts",
    "data:chunk-public": "tsx scripts/chunk-public-data.ts",
    "data:enrich-geography": "tsx scripts/enrich-geography.ts",
    "data:backfill-current-form144": "tsx scripts/backfill-current-form144.ts",
    "data:backfill-filing-locations": "tsx scripts/backfill-current-filing-locations.ts",
    "data:correct-valuations": "tsx scripts/correct-public-valuations.ts",
    "data:audit-valuations": "tsx scripts/audit-public-valuations.ts",
    "ingest:sec": "tsx scripts/jobs.ts sec",
    "ingest:feeds": "tsx scripts/jobs.ts feeds",
    "estimates:recalculate": "tsx scripts/jobs.ts estimates",
    "aggregates:rebuild": "tsx scripts/jobs.ts aggregates",
    "fixtures:load": "tsx scripts/jobs.ts fixtures"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "drizzle-orm": "0.45.2",
    "jspdf": "^3.0.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "csv-parse": "^6.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
